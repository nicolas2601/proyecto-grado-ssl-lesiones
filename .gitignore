# --- Pesos y checkpoints (no versionar binarios pesados) ---
*.pth
*.pt
*.ckpt
*.onnx

# --- Datos (los datasets viven en Kaggle / UNAB, NO en el repo) ---
datasets/
*.jpg
# Imágenes: ignoradas por defecto, salvo docs, figuras y model card
*.png
!docs/**/*.png
!assets/figuras/*.png
# CSV: ignorados salvo docs
*.csv
!docs/**/*.csv
# data/: solo versionamos el resumen de resultados, no datasets crudos
data/*
!data/RESULTS_SUMMARY.json

# --- Secretos (NUNCA commitear) ---
.env
*.key
kaggle.json
*credentials*

# --- Salidas del pipeline v5 (regenerables, no versionar) ---
out/
features/
*.npy

# --- Python / Jupyter ---
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.venv/
.venv-charts/
.venv-demo/
venv/

# --- SO / editor ---
.DS_Store
.idea/
.vscode/

# --- estado local del driver de bancos Kaggle ---
results/**/.run_state.json
